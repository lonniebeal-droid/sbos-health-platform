# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: The Gemini model id used by all /api/ai/* endpoints.
# Defaults to gemini-2.0-flash. Confirm the model is available on your account.
GEMINI_MODEL="gemini-2.0-flash"

# GEMINI_TIMEOUT_MS: Upstream request timeout (ms) for Gemini calls so a hung
# request can't hold an /api/ai/* HTTP request open indefinitely. Default 30000.
GEMINI_TIMEOUT_MS="30000"

# Supabase (local dev). Values come from `supabase start` output.
# VITE_ prefix is required for the browser client (src/lib/supabaseClient.ts).
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
# Server-side only (full access — never expose to the client bundle):
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Production auth config ---
# NODE_ENV: Set to "production" in deployed environments. Enables HSTS headers,
# disables Vite dev middleware, and serves the built SPA from dist/.
NODE_ENV="development"

# PORT: Server listen port. Default 3000. Cloud Run / container orchestrators
# inject PORT automatically — do not hard-code a different value.
PORT="3000"

# SUPABASE_REDIRECT_URL: Post-login redirect for OAuth / magic-link flows.
# Must match one of the "Redirect URLs" in your Supabase project's Auth settings.
# For local dev this is the Vite dev server; for production, your deployed origin.
SUPABASE_REDIRECT_URL="http://localhost:3000"

# JWT_SECRET (optional): If your Supabase project uses a custom JWT secret for
# server-side token verification, set it here. The default Supabase JWT secret
# is used when this is omitted.
# JWT_SECRET="your-custom-jwt-secret"
