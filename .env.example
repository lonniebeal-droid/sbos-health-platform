# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: The Gemini model id used by all /api/ai/* endpoints.
# Defaults to gemini-2.0-flash. Confirm the model is available on your account.
GEMINI_MODEL="gemini-2.0-flash"

# Supabase (local dev). Values come from `supabase start` output.
# VITE_ prefix is required for the browser client (src/lib/supabaseClient.ts).
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
# Server-side only (full access — never expose to the client bundle):
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
